## Cosmoe Generic Makefile ##
## Based on Haiku Generic Makefile v2.6 ##

## Does all the hard work for the Generic Makefile, which only has to specify
## the project parameters.

## Supports Generic Makefile v2.6.
##   Probably works with Generic Makefile v2.0+, but support is not guaranteed.

# Detect the platform
UNAME_S := $(shell uname -s)

# Determine the CPU type
MACHINE=$(shell uname -m)
ifeq ($(MACHINE), BePC)
	CPU = x86
else
	CPU = $(MACHINE)
endif

# macOS-specific configuration
ifeq ($(UNAME_S), Darwin)
	# Add Homebrew ICU path to PKG_CONFIG_PATH for macOS
	export PKG_CONFIG_PATH := /opt/homebrew/opt/icu4c/lib/pkgconfig:$(PKG_CONFIG_PATH)
endif

# Set up defaults.
ifeq ($(NAME), )
	NAME = NameThisApp
endif

ifeq ($(TYPE), )
	TYPE = APP
endif

ifeq ($(APP_MIME_SIG), )
	APP_MIME = x.vnd-Cosmoe-$(NAME)
endif

ifeq ($(DRIVER_PATH), )
	DRIVER_PATH = misc
endif

# Base install root for Cosmoe headers, libraries, and default install targets.
# Override with either PREFIX or COSMOE_INSTALL_ROOT.
COSMOE_INSTALL_ROOT_DEFAULT := @COSMOE_INSTALL_ROOT_DEFAULT@
ifneq ($(findstring @,$(COSMOE_INSTALL_ROOT_DEFAULT)),)
	COSMOE_INSTALL_ROOT_DEFAULT := /usr/local
endif
COSMOE_INSTALL_ROOT ?= $(if $(PREFIX),$(PREFIX),$(COSMOE_INSTALL_ROOT_DEFAULT))
COSMOE_INCLUDE_ROOT := $(COSMOE_INSTALL_ROOT)/include
COSMOE_LIB_ROOT := $(COSMOE_INSTALL_ROOT)/lib
DEFAULT_INSTALL_DIR := $(if $(filter STATIC SHARED,$(strip $(TYPE))),$(COSMOE_LIB_ROOT),$(COSMOE_INSTALL_ROOT)/bin)
EFFECTIVE_INSTALL_DIR := $(if $(INSTALL_DIR),$(INSTALL_DIR),$(DEFAULT_INSTALL_DIR))

# Set the core tools if they're not already specified.
# Unlike Haiku, XRES is not used for bundling resources.

MIMESET	:= mimeset
RESCOMP	:= rc
ifeq ($(strip $(CC)),)
	CC	:= cc
endif
ifeq ($(strip $(CXX)),)
	CXX	:= g++
endif
C++		:= $(CXX)

# Set up optimization flags.
ifeq ($(strip $(OPTIMIZE)), FULL)
	OPTIMIZER	= -O3
else
ifeq ($(strip $(OPTIMIZE)), SOME)
	OPTIMIZER	= -O1
else
ifeq ($(strip $(OPTIMIZE)), NONE)
	OPTIMIZER	= -O0
else
#	OPTIMIZE isn't set, so set it to FULL
	OPTIMIZER	= -O3
endif
endif
endif

# Set up debug information flags.
ifeq ($(strip $(DEBUGGER)), TRUE)
	DEBUG += -g
	OPTIMIZER = -O0
endif
CFLAGS += $(OPTIMIZER) $(DEBUG)
CXXFLAGS += $(OPTIMIZER) $(DEBUG)

# Set up the warning flags.
#ifeq ($(strip $(WARNINGS)), ALL)
	CFLAGS += -Wall -Wno-multichar
	CXXFLAGS += -Wall -Wno-multichar -Wno-ctor-dtor-privacy
ifeq ($(UNAME_S), Darwin)
	# On MacOS (case-insensitive filesystem), Cosmoe headers like <String.h> differ
	# in case from C stdlib headers like <string.h>, triggering this warning.
	# The case difference is intentional, so suppress this warning.
	CFLAGS += -Wno-nonportable-include-path
	CXXFLAGS += -Wno-nonportable-include-path
endif
#else
#ifeq ($(strip $(WARNINGS)), NONE)
#	CFLAGS += -w
#	CXXFLAGS += -w
#endif
#endif

# Set up the linker & linker flags.
ifeq ($(origin LD), default)
	LD			:= $(CC)
endif
LDFLAGS		+= $(DEBUG)

# Binary-type-specific linker flags.
ifeq ($(strip $(TYPE)), SHARED)
	LDFLAGS += -shared
endif

# Get the compiler version.
CC_VER = $(word 1, $(subst -, , $(subst ., , $(shell $(CC) -dumpversion))))

# Set the object directory if it isn't already.
OBJ_DIR := objects.$(CPU)-$(CC)$(CC_VER)-$(if $(DEBUGGER),debug,release)

# Output the binary alongside the objects unless another directory is specified.
ifeq ($(TARGET_DIR), )
	TARGET_DIR	:= $(OBJ_DIR)
endif

# NOTE: make doesn't find the target if its name is enclosed in quotes.
ifeq ($(strip $(TYPE)), STATIC)
	TARGET		:= $(TARGET_DIR)/$(NAME).a
else
	TARGET		:= $(TARGET_DIR)/$(NAME)
endif

# Psuedo-function for converting a list of source files in SRCS variable to a
# corresponding list of object files in $(OBJ_DIR)/xxx.o. The "function" strips
# off the src file suffix (.ccp or .c or whatever) and then strips off the
# off the directory name, leaving just the root file name. It then appends the
# .o suffix and prepends the $(OBJ_DIR)/ path
define SRCS_LIST_TO_OBJS
	$(addprefix $(OBJ_DIR)/, $(addsuffix .o, $(foreach file, $(SRCS), \
	$(basename $(notdir $(file))))))
endef

define SRCS_LIST_TO_DEPENDS
	$(addprefix $(OBJ_DIR)/, $(addsuffix .d, $(foreach file, $(SRCS), \
	$(basename $(notdir $(file))))))
endef

OBJS = $(SRCS_LIST_TO_OBJS)
DEPENDS = $(SRCS_LIST_TO_DEPENDS)

# Create a unique list of paths to our sourcefiles and resources.
SRC_PATHS += $(sort $(foreach file, $(SRCS) $(RSRCS) $(RDEFS), $(dir $(file))))

# Add source paths to VPATH if not already present.
VPATH :=
VPATH += $(addprefix :, $(subst  ,:, $(filter-out $($(subst, :, ,$(VPATH))), $(SRC_PATHS))))

# Add standard Cosmoe system include paths to SYSTEM_INCLUDE_PATHS.
# Use += to append to any paths already set by the user's Makefile.
SYSTEM_INCLUDE_PATHS += \
	$(COSMOE_INCLUDE_ROOT)/config \
	$(COSMOE_INCLUDE_ROOT)/os \
	$(COSMOE_INCLUDE_ROOT)/os/app \
	$(COSMOE_INCLUDE_ROOT)/os/game \
	$(COSMOE_INCLUDE_ROOT)/os/interface \
	$(COSMOE_INCLUDE_ROOT)/os/kernel \
	$(COSMOE_INCLUDE_ROOT)/os/locale \
	$(COSMOE_INCLUDE_ROOT)/os/media \
	$(COSMOE_INCLUDE_ROOT)/os/net \
	$(COSMOE_INCLUDE_ROOT)/os/storage \
	$(COSMOE_INCLUDE_ROOT)/os/support \
	$(COSMOE_INCLUDE_ROOT)/os/translation \
	$(COSMOE_INCLUDE_ROOT)/os/be_apps/Tracker \
	$(COSMOE_INCLUDE_ROOT)/private/interface \
	$(COSMOE_INCLUDE_ROOT)/private/netservices \
	$(COSMOE_INCLUDE_ROOT)/private/shared \
	$(COSMOE_INCLUDE_ROOT)/private/support \
	$(COSMOE_INCLUDE_ROOT)/private/interface \
	$(COSMOE_INCLUDE_ROOT)/libs/agg/

# Set up the local & system include paths and C++ stdlibs.
LOC_INCLUDES = $(foreach path, $(SRC_PATHS) $(LOCAL_INCLUDE_PATHS), $(addprefix -I, $(path)))
INCLUDES = -iquote./
INCLUDES += $(foreach path, $(SRC_PATHS) $(LOCAL_INCLUDE_PATHS), $(addprefix -iquote, $(path)))
ifeq ($(UNAME_S), Darwin)
	# On the case-sensitive build image, image-local copies of Cosmoe headers are
	# searched first via -I so that e.g. <String.h> finds Haiku's BString header
	# rather than the host's <string.h>.
	INCLUDES += $(foreach path, $(patsubst $(COSMOE_INCLUDE_ROOT)%,$(MAC_INCLUDE_DIR)%,$(SYSTEM_INCLUDE_PATHS)), $(addprefix -I, $(path)))
else
	INCLUDES += $(foreach path, $(SYSTEM_INCLUDE_PATHS), $(addprefix -I, $(path)))
endif

STDCPPLIBS = stdc++

# Standard set of libraries needed for Cosmoe.
LIBS += cairo pango-1.0 pangocairo-1.0 m

# Remove libraries that have been folded into libbe in Cosmoe.
LIBS := $(filter-out shared translation network agg columnlistview media, $(LIBS))

# Fix library order for proper linking.
# Some libraries depend on others and must be linked in the correct order.
# Dependencies should come AFTER the libraries that use them.
# Check if both bnetapi and netservices are present, and ensure netservices comes before bnetapi
# Having this backwards seems to be very common in Haiku app makefiles.
ifneq ($(filter bnetapi,$(LIBS)),)
    ifneq ($(filter netservices,$(LIBS)),)
        # Remove both libraries
        LIBS := $(filter-out bnetapi netservices,$(LIBS))
        # Add them back in the correct order: netservices first, then bnetapi
        LIBS += netservices bnetapi
    endif
endif

# libstdc++ is a hard requirement - if they didn't bother to include it, add it now.
ifeq ($(filter stdc++,$(LIBS)),)
    LIBS += stdc++
endif


# Platform-specific library paths
ifeq ($(UNAME_S), Darwin)
	# macOS: Add Homebrew library paths
	LIBPATHS += /opt/homebrew/lib $(COSMOE_LIB_ROOT)
	LIBS += macmain
else ifeq ($(UNAME_S), Linux)
	# Linux: Detect the correct library directory for this system
	# Try to get multiarch tuple from gcc (e.g., x86_64-linux-gnu)
	MULTIARCH := $(shell $(CC) -print-multiarch 2>/dev/null)
	
	ifneq ($(MULTIARCH),)
		# Multiarch system (Debian/Ubuntu style)
		DETECTED_LIBDIR := $(COSMOE_LIB_ROOT)/$(MULTIARCH)
		LIBPATHS += $(DETECTED_LIBDIR)
	else
		# Check for lib64 on 64-bit systems
		ifeq ($(shell uname -m),x86_64)
			ifneq ($(wildcard $(COSMOE_INSTALL_ROOT)/lib64),)
				DETECTED_LIBDIR := $(COSMOE_INSTALL_ROOT)/lib64
				LIBPATHS += $(DETECTED_LIBDIR)
			else
				DETECTED_LIBDIR := $(COSMOE_LIB_ROOT)
				LIBPATHS += $(DETECTED_LIBDIR)
			endif
		else
			DETECTED_LIBDIR := $(COSMOE_LIB_ROOT)
			LIBPATHS += $(DETECTED_LIBDIR)
		endif
	endif
endif



# Add the -L prefix to all of the library paths.
LINK_PATHS = $(foreach path, $(SRC_PATHS) $(LIBPATHS), \
	$(addprefix -L, $(path)))

# Handle the additional libraries specified. If the libraries have a .so or
# a .a prefix, or if they are _APP_ or _KERNEL_, simply add them to the list.
LINK_LIBS += $(filter %.so %.so.* %.dylib %.dll %.a _APP_ _KERNEL_, $(LIBS))
# If the libraries do not have suffixes and are not _APP_ or _KERNEL_,
# prepend -l to each name:(e.g. "be" becomes "-lbe").
LINK_LIBS += $(foreach lib, $(filter-out %.so %.so.* %.dylib %.dll %.a _APP_ _KERNEL_, $(LIBS)), $(addprefix -l, $(lib)))

# Add the linkpaths and linklibs to LDFLAGS.
LDFLAGS += $(LINK_PATHS)  $(LINK_LIBS)

# Add the defines to CFLAGS.
CFLAGS += $(foreach define, $(DEFINES), $(addprefix -D, $(define)))
CXXFLAGS += $(foreach define, $(DEFINES), $(addprefix -D, $(define)))

# Filter out x86-specific flags on non-x86 platforms.
ifneq ($(CPU), x86)
ifneq ($(CPU), x86_64)
	COMPILER_FLAGS := $(filter-out -mmmx -msse -msse2 -msse3 -mssse3 -msse4.1 -msse4.2 -msse4 -mavx -mavx2, $(COMPILER_FLAGS))
endif
endif

# Add the additional compiler flags to CFLAGS.
CFLAGS += $(COMPILER_FLAGS)
CXXFLAGS += $(COMPILER_FLAGS)

# Add the additional linkflags to LDFLAGS
LDFLAGS += $(LINKER_FLAGS)

# Platform-specific linker flags
ifeq ($(UNAME_S), Darwin)
	# macOS: Add rpath for finding libraries at runtime
	LDFLAGS += -Wl,-rpath,$(COSMOE_LIB_ROOT) -Wl,-rpath,@executable_path
	LDFLAGS += -framework Foundation -framework Cocoa
else ifeq ($(UNAME_S), Linux)
	# Linux: Add rpath to the detected library directory
	# This allows executables to find libbe.so regardless of multiarch paths
	ifdef DETECTED_LIBDIR
		LDFLAGS += -Wl,-rpath,$(DETECTED_LIBDIR)
	endif
	# Also add $ORIGIN for finding libraries relative to the executable
	LDFLAGS += -Wl,-rpath,$$ORIGIN
endif

# Use the archiving tools to create an an archive if we're building a static
# library, otherwise use the linker.
ifeq ($(strip $(TYPE)), STATIC)
	BUILD_LINE = ar -cru "$(TARGET)" $(OBJS)
else
	BUILD_LINE = $(LD) -o "$@" $(OBJS) $(RSRC_OBJS) $(LDFLAGS)
endif

# Pseudo-function for converting a list of resource definition files in RDEFS
# variable to a corresponding list of intermediate .rsrc files in $(OBJ_DIR)/xxx.rsrc.
# The "function" strips off the rdef file suffix (.rdef) and then strips
# off the directory name, leaving just the root file name. It then appends the
# .rsrc suffix and prepends the $(OBJ_DIR)/ path.
define RDEFS_LIST_TO_RSRCS
	$(addprefix $(OBJ_DIR)/, $(addsuffix .rsrc, $(foreach file, $(RDEFS), \
	$(basename $(notdir $(file))))))
endef

# Pseudo-function for converting .rsrc files to .rsrc.o object files.
define RSRCS_LIST_TO_OBJS
	$(addsuffix .o, $(1))
endef

# Create the resource definitions instruction in case RDEFS is not empty.
ifeq ($(RDEFS), )
	RSRCS +=
	RSRC_OBJS :=
else
	RSRCS += $(RDEFS_LIST_TO_RSRCS)
	RSRC_OBJS := $(call RSRCS_LIST_TO_OBJS,$(RSRCS))
endif

# Set the directory for internationalization sources (catkeys) if it isn't
# already.
CATKEYS_DIR	:= locales

# Set the directory for internationalization resource data (catalogs) if it
# isn't already.
CATALOGS_DIR := $(OBJ_DIR)/$(APP_MIME_SIG)

# Pseudo-function for converting a list of language codes in CATALOGS variable
# to a corresponding list of catkeys files in $(CATALOGS_DIR)/xx.catalog
# The "function" appends the .catalog suffix and prepends the
# $(CATALOGS_DIR)/ path.
define LOCALES_LIST_TO_CATALOGS
	$(addprefix $(CATALOGS_DIR)/, $(addsuffix .catalog, $(foreach lang, $(LOCALES), $(lang))))
endef

CATALOGS = $(LOCALES_LIST_TO_CATALOGS)

# macOS case-sensitive filesystem build support
ifeq ($(UNAME_S), Darwin)
	# Configuration for case-sensitive disk image
	MAC_SOURCE_DIR := $(abspath $(CURDIR))
	MAC_SOURCE_BASENAME := $(notdir $(MAC_SOURCE_DIR))
	# Use a filesystem-safe project tag for image names. Do not use $(NAME),
	# because app names may contain relative path components like ../.
	MAC_IMAGE_TAG := $(shell printf '%s' "$(MAC_SOURCE_BASENAME)" | sed 's/[^[:alnum:]_.-]/-/g')
	MAC_IMAGE_NAME := cosmoe-build-$(MAC_IMAGE_TAG)
	MAC_IMAGE_SIZE := 2g
	MAC_MOUNT_POINT := /Volumes/$(MAC_IMAGE_NAME)
	MAC_INCLUDE_DIR := $(MAC_MOUNT_POINT)/include
	MAC_IMAGE_PATH := $(HOME)/.cosmoe-builds/$(MAC_IMAGE_NAME).sparseimage
	MAC_BUILD_ROOT := $(MAC_MOUNT_POINT)/builds
	MAC_BUILD_DIR := $(MAC_BUILD_ROOT)/$(MAC_SOURCE_BASENAME)
	
	# Check if we're already running on the case-sensitive image
	MAC_ON_IMAGE := $(shell df "$(MAC_SOURCE_DIR)" 2>/dev/null | grep -q " $(MAC_MOUNT_POINT)$$" && echo yes || echo no)
endif

# Define the actual work to be done.
ifeq ($(UNAME_S), Darwin)
    ifeq ($(MAC_ON_IMAGE), no)
        # We're on macOS but NOT on the case-sensitive image - need to orchestrate
        default: mac-build-on-image
        
        .PHONY: mac-build-on-image mac-setup-image mac-setup-headers mac-sync-to-image
        
        mac-build-on-image: mac-setup-image mac-setup-headers mac-sync-to-image
		@echo "=== Building $(NAME) on case-sensitive image ==="
		@cd "$(MAC_BUILD_DIR)" && $(MAKE) MAC_ON_IMAGE=yes COSMOE_INCLUDE_ROOT="$(MAC_INCLUDE_DIR)"
		@echo "=== Syncing built artifacts back ==="
		@rsync -av "$(MAC_BUILD_DIR)/$(OBJ_DIR)/" "$(MAC_SOURCE_DIR)/$(OBJ_DIR)/" 2>/dev/null || true
		@if [ -f "$(MAC_BUILD_DIR)/$(TARGET)" ]; then \
		    mkdir -p "$(MAC_SOURCE_DIR)/$(TARGET_DIR)"; \
		    cp -f "$(MAC_BUILD_DIR)/$(TARGET)" "$(MAC_SOURCE_DIR)/$(TARGET)"; \
		    echo "✓ Built: $(TARGET)"; \
		fi
        
        mac-setup-image:
		@if [ ! -f "$(MAC_IMAGE_PATH)" ]; then \
		    echo "Creating case-sensitive disk image for $(MAC_SOURCE_BASENAME)..."; \
		    mkdir -p "$$(dirname "$(MAC_IMAGE_PATH)")"; \
		    hdiutil create -size "$(MAC_IMAGE_SIZE)" -type SPARSE \
		        -fs "Case-sensitive APFS" -volname "$(MAC_IMAGE_NAME)" \
		        "$(MAC_IMAGE_PATH)" >/dev/null 2>&1; \
		    echo "✓ Image created"; \
		fi
		@if [ ! -d "$(MAC_MOUNT_POINT)" ]; then \
		    echo "Mounting case-sensitive image..."; \
		    hdiutil attach "$(MAC_IMAGE_PATH)" >/dev/null 2>&1; \
		    echo "✓ Image mounted at $(MAC_MOUNT_POINT)"; \
		fi
        
        mac-setup-headers:
		@echo "Syncing Cosmoe headers to case-sensitive disk image..."
		@mkdir -p "$(MAC_INCLUDE_DIR)"
		@for dir in config os private libs; do \
		    if [ -d "$(COSMOE_INCLUDE_ROOT)/$$dir" ]; then \
		        rsync -a "$(COSMOE_INCLUDE_ROOT)/$$dir/" "$(MAC_INCLUDE_DIR)/$$dir/"; \
		    fi; \
		done
		@echo "✓ Cosmoe headers synced to image"
       
        mac-sync-to-image:
		@echo "Syncing source to case-sensitive disk image..."
		@mkdir -p "$(MAC_BUILD_ROOT)"
		@rsync -a --delete \
		    --exclude='$(OBJ_DIR)' \
		    --exclude='*.o' \
		    --exclude='*.dylib' \
		    --exclude='*.a' \
		    --exclude='*.d' \
		    --exclude='*.so' \
		    --exclude='.git' \
		    "$(MAC_SOURCE_DIR)/" "$(MAC_BUILD_DIR)/"
		@echo "✓ Source synced"
    else
        # We're already on the case-sensitive image - do normal build
        default: $(TARGET)
    endif
else
    # Non-macOS platforms - do normal build
    default: $(TARGET)
endif

$(TARGET):	$(OBJ_DIR) $(OBJS) $(RSRC_OBJS)
	$(BUILD_LINE)
	$(MIMESET) -f "$@"

# Create OBJ_DIR if it doesn't exist.
$(OBJ_DIR)::
	@[ -d $(OBJ_DIR) ] || mkdir $(OBJ_DIR) >/dev/null 2>&1

# Create the localization sources directory if it doesn't exist.
$(CATKEYS_DIR)::
	@[ -d $(CATKEYS_DIR) ] || mkdir $(CATKEYS_DIR) >/dev/null 2>&1

# Create the localization data directory if it doesn't exist.
$(CATALOGS_DIR):: $(OBJ_DIR)
	@[ -d $(CATALOGS_DIR) ] || mkdir $(CATALOGS_DIR) >/dev/null 2>&1

# Rules to create the dependency files.
$(OBJ_DIR)/%.d : %.c
	mkdir -p $(OBJ_DIR); \
	mkdepend $(LOC_INCLUDES) -p .c:$(OBJ_DIR)/%n.o -m -f "$@" $<
$(OBJ_DIR)/%.d : %.cpp
	mkdir -p $(OBJ_DIR); \
	mkdepend $(LOC_INCLUDES) -p .cpp:$(OBJ_DIR)/%n.o -m -f "$@" $<
$(OBJ_DIR)/%.d : %.cp
	mkdir -p $(OBJ_DIR); \
	mkdepend $(LOC_INCLUDES) -p .cp:$(OBJ_DIR)/%n.o -m -f "$@" $<
$(OBJ_DIR)/%.d : %.cc
	mkdir -p $(OBJ_DIR); \
	mkdepend $(LOC_INCLUDES) -p .cc:$(OBJ_DIR)/%n.o -m -f "$@" $<
$(OBJ_DIR)/%.d : %.cxx
	mkdir -p $(OBJ_DIR); \
	mkdepend $(LOC_INCLUDES) -p .cxx:$(OBJ_DIR)/%n.o -m -f "$@" $<
$(OBJ_DIR)/%.d : %.C
	mkdir -p $(OBJ_DIR); \
	mkdepend $(LOC_INCLUDES) -p .C:$(OBJ_DIR)/%n.o -m -f "$@" $<
$(OBJ_DIR)/%.d : %.CC
	mkdir -p $(OBJ_DIR); \
	mkdepend $(LOC_INCLUDES) -p .CC:$(OBJ_DIR)/%n.o -m -f "$@" $<
$(OBJ_DIR)/%.d : %.CPP
	mkdir -p $(OBJ_DIR); \
	mkdepend $(LOC_INCLUDES) -p .CPP:$(OBJ_DIR)/%n.o -m -f "$@" $<
$(OBJ_DIR)/%.d : %.CXX
	mkdir -p $(OBJ_DIR); \
	mkdepend $(LOC_INCLUDES) -p .CXX:$(OBJ_DIR)/%n.o -m -f "$@" $<

-include $(DEPENDS)

# Rules to make the object files.
$(OBJ_DIR)/%.o : %.c
	$(CC) -c $< $(INCLUDES) $(CFLAGS) -o "$@"
$(OBJ_DIR)/%.o : %.cpp
	$(C++) -c $< $(INCLUDES) $(CXXFLAGS) -o "$@"
$(OBJ_DIR)/%.o : %.cp
	$(CC) -c $< $(INCLUDES) $(CXXFLAGS) -o "$@"
$(OBJ_DIR)/%.o : %.cc
	$(C++) -c $< $(INCLUDES) $(CXXFLAGS) -o "$@"
$(OBJ_DIR)/%.o : %.cxx
	$(C++) -c $< $(INCLUDES) $(CXXFLAGS) -o "$@"
$(OBJ_DIR)/%.o : %.C
	$(CC) -c $< $(INCLUDES) $(CFLAGS) -o "$@"
$(OBJ_DIR)/%.o : %.CC
	$(C++) -c $< $(INCLUDES) $(CXXFLAGS) -o "$@"
$(OBJ_DIR)/%.o : %.CPP
	$(C++) -c $< $(INCLUDES) $(CXXFLAGS) -o "$@"
$(OBJ_DIR)/%.o : %.CXX
	$(C++) -c $< $(INCLUDES) $(CXXFLAGS) -o "$@"

# Rules to compile the resource definition files.
$(OBJ_DIR)/%.rsrc : %.rdef
	cat $< | $(CC) -E $(INCLUDES) $(CFLAGS) - | grep -av '^#' | $(RESCOMP) -I $(dir $<) -o "$@" -
$(OBJ_DIR)/%.rsrc : %.RDEF
	cat $< | $(CC) -E $(INCLUDES) $(CFLAGS) - | grep -av '^#' | $(RESCOMP) -I $(dir $<) -o "$@" -

# Rule to convert .rsrc files to .rsrc.o object files.
# Darwin uses ld -sectcreate to inject the resource payload into a stub object.
# Linux keeps the existing binary-to-object flow and renames the payload section.
ifeq ($(UNAME_S), Darwin)
$(OBJ_DIR)/%.rsrc.o : $(OBJ_DIR)/%.rsrc
	@INPUT_ABS=$$(cd $$(dirname "$<") && pwd)/$$(basename "$<"); \
	OUTPUT_ABS=$$(cd $$(dirname "$@") && pwd)/$$(basename "$@"); \
	STUB_O="$(OBJ_DIR)/$*_rsrc_stub.o"; \
	STUB_SYMBOL=$$(printf '%s' "$*" | sed 's/[^[:alnum:]_]/_/g'); \
	printf 'void _cosmoe_rsrc_stub_%s(void) {}\n' "$$STUB_SYMBOL" | \
		$(CC) -x c - -c -o "$$STUB_O" && \
	ld -r "$$STUB_O" -sectcreate __TEXT __rsrc "$$INPUT_ABS" -o "$$OUTPUT_ABS" && \
	rm -f "$$STUB_O"
else
$(OBJ_DIR)/%.rsrc.o : $(OBJ_DIR)/%.rsrc
	@INPUT_DIR=$$(dirname "$<"); \
	INPUT_FILE=$$(basename "$<"); \
	OUTPUT_ABS=$$(cd $$(dirname "$@") && pwd)/$$(basename "$@"); \
	cd "$$INPUT_DIR" && \
	ld -r -b binary "$$INPUT_FILE" -o "$$OUTPUT_ABS" && \
	objcopy --rename-section .data=.cosmoe_rsrc "$$OUTPUT_ABS" && \
	objcopy --add-section .note.GNU-stack=/dev/null \
		--set-section-flags .note.GNU-stack=noload,readonly \
		"$$OUTPUT_ABS"
endif

# Rule to compile localization data catalogs.
$(CATALOGS_DIR)/%.catalog : $(CATKEYS_DIR)/%.catkeys
	linkcatkeys -o "$@" -s $(APP_MIME_SIG) -l $(notdir $(basename $@)) $<

# Rule to preprocess program sources into file ready for collecting catkeys.
$(OBJ_DIR)/$(NAME).pre : $(SRCS)
	-cat $(SRCS) | $(CC) -E -x c++ $(INCLUDES) $(CFLAGS) -DB_COLLECTING_CATKEYS - | grep -av '^#' > $(OBJ_DIR)/$(NAME).pre

# Rules to collect localization catkeys.
catkeys : $(CATKEYS_DIR)/en.catkeys

$(CATKEYS_DIR)/en.catkeys : $(CATKEYS_DIR) $(OBJ_DIR)/$(NAME).pre
	collectcatkeys -s $(APP_MIME_SIG) $(OBJ_DIR)/$(NAME).pre -o $(CATKEYS_DIR)/en.catkeys

# Rule to create localization catalogs.
catalogs : $(CATALOGS_DIR) $(CATALOGS)

# Rules to handle lex/flex and yacc/bison files.
$(OBJ_DIR)/%.o: %.l
	flex $<
	$(CC) -c $(INCLUDES) $(CFLAGS) lex.yy.c -o "$@"
$(OBJ_DIR)/%.o: %.y
	bison -d -y $<
	$(CC) -c $(INCLUDES) $(CFLAGS) y.tab.c -o "$@"

# The generic "clean" command. (Deletes everything in the object folder.)
.PHONY: clean
clean:
	-rm -rf "$(OBJ_DIR)"
ifeq ($(UNAME_S), Darwin)
    ifeq ($(MAC_ON_IMAGE), no)
	@if [ -d "$(MAC_MOUNT_POINT)" ]; then \
	    echo "Cleaning build on case-sensitive image..."; \
	    rm -rf "$(MAC_BUILD_DIR)/$(OBJ_DIR)" 2>/dev/null || true; \
	fi
    endif
endif

# Remove just the application from the object folder.
rmapp ::
	-rm -f $(TARGET)

# macOS: Unmount the case-sensitive disk image
ifeq ($(UNAME_S), Darwin)
.PHONY: mac-unmount mac-distclean

mac-unmount:
	@if [ -d "$(MAC_MOUNT_POINT)" ]; then \
	    echo "Unmounting $(MAC_MOUNT_POINT)..."; \
	    hdiutil detach "$(MAC_MOUNT_POINT)" 2>/dev/null || true; \
	    echo "✓ Image unmounted"; \
	else \
	    echo "✓ Image not mounted"; \
	fi

mac-distclean: mac-unmount
	@if [ -f "$(MAC_IMAGE_PATH)" ]; then \
	    echo "Removing disk image $(MAC_IMAGE_PATH)..."; \
	    rm -f "$(MAC_IMAGE_PATH)"; \
	    echo "✓ Image removed"; \
	else \
	    echo "✓ Image doesn't exist"; \
	fi
endif

install :: default
	mkdir -p "$(DESTDIR)$(EFFECTIVE_INSTALL_DIR)"
	cp $(TARGET) "$(DESTDIR)$(EFFECTIVE_INSTALL_DIR)"/$(NAME)

# Set the catalog installation directory if it isn't already.
CATALOG_INSTALL_DIR := $(shell finddir B_USER_NONPACKAGED_DATA_DIRECTORY)/locale/catalogs

# Rule to install localization resources catalogs.
catalogsinstall :: catalogs
	mkdir -p "$(DESTDIR)$(CATALOG_INSTALL_DIR)/$(APP_MIME_SIG)"
	-cp $(CATALOGS_DIR)/*.catalog "$(DESTDIR)$(CATALOG_INSTALL_DIR)/$(APP_MIME_SIG)"

# Alternate way of storing localization catalogs: bind them into the program
# executable's resources.
bindcatalogs :
	for lc in $(LOCALES); do linkcatkeys -o $(TARGET) -s $(APP_MIME_SIG) -tr -l $$lc $(CATKEYS_DIR)/$$lc.catkeys; done
