bindir=@bindir@

CFLAGS  = -pipe -O2 -g `pkg-config freetype2 --cflags` -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs` -I../shared
CPPFLAGS= $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

VPATH += ../shared

EXE = BMPTranslator

OBJS =	BMPMain.o BMPTranslator.o BMPView.o \
			BaseTranslator.o TranslatorSettings.o StreamBuffer.o TranslatorWindow.o

include @top_srcdir@/makefile.rules

all :	$(OBJDIR) $(OBJDIR)/$(EXE)

$(OBJDIR):
	mkdir $(OBJDIR)

$(OBJDIR)/$(EXE): $(OBJS) Makefile
	$(CC) -g -rdynamic $(OBJS) -L$(BELIBDIR) -lbe \
		-lwayland-client -lwayland-cursor -lxkbcommon -lcairo -lpango-1.0 -lpangocairo-1.0 -lweston-14 -ljpeg -lwebp -lz -lstdc++ \
		-o $@

install: $(OBJDIR)/$(EXE) $(bindir)
	cp -f $(OBJDIR)/$(EXE) $(bindir)

$(bindir):
	mkdir -p $(bindir)

deps: $(OBJDIR) $(DEPS)

clean:
	rm -f $(OBJS) $(OBJDIR)/*.d $(OBJDIR)/$(EXE) *~

distclean: clean
	rm -f Makefile

-include $(OBJDIR)/*.d

.PHONY: clean distclean deps doc install uninstall all
