CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS)

EXE	= calc

OBJS := Calculator.o CalcEngine.o CalcView.o CalcWindow.o FrameView.o

include @top_srcdir@/makefile.rules

$(EXE): $(OBJDIR) $(OBJS) Makefile
	$(CC) -g $(OBJS) -lstdc++ -L$(BELIBDIR) -lbe -lm -o $(EXE)

$(OBJDIR):
	mkdir $(OBJDIR)

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)
	strip --strip-all $(bindir)/$(EXE)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm -f $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile
	-rm -rf $(OBJDIR)

.PHONY: clean distclean deps doc install uninstall all
