prefix=@prefix@
bindir=${prefix}/bin

CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS)

CC	= @CC@
CXX	= @CXX@
EXE	= calc

OBJS := Calculator.o CalcEngine.o CalcView.o CalcWindow.o FrameView.o

include @top_srcdir@/makefile.rules

$(EXE): objs $(OBJS) Makefile
	$(CC) -g $(OBJS) -lstdc++ -L$(COSMOELIBDIR) -lcosmoe -lm -o $(EXE)

objs:
	mkdir objs

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)
	strip --strip-all $(bindir)/$(EXE)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm -f $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile

.PHONY: clean distclean deps doc install uninstall all
