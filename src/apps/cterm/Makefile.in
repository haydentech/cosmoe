prefix=@prefix@
bindir=$(prefix)/bin

CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

CC	= @CC@
CXX	= @CXX@
EXE	= cterm

include @top_srcdir@/makefile.rules

OBJS := TermApp.o TermView.o TermWindow.o


$(EXE): objs $(OBJS) Makefile
	$(CXX) $(OBJS) -L$(COSMOELIBDIR) -lcosmoe -o $@

objs:
	mkdir objs

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)
	strip --strip-all $(bindir)/$(EXE)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm -f $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile

.PHONY: clean distclean deps doc install uninstall all
