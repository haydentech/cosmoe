prefix=@prefix@
bindir=$(prefix)/bin

CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CXXFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

CC	= @CC@
CXX	= @CXX@
EXE	= cterm
COSMOELIBDIR = @top_srcdir@/src/kits/objs

OBJDIR	:= objs


$(OBJDIR)/%.o : %.c
	$(CC) $(CFLAGS) $< -o $@

$(OBJDIR)/%.o : %.cpp
	$(CXX) $(CXXFLAGS) $< -o $@


OBJS := TermApp.o TermView.o TermWindow.o
OBJS := $(addprefix $(OBJDIR)/,$(OBJS))


$(EXE): objs $(OBJS) Makefile
	$(CXX) $(OBJS) -L$(COSMOELIBDIR) -lcosmoe -o $@

objs:
	mkdir objs

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)
	strip --strip-all $(bindir)/$(EXE)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm -f $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile

.PHONY: clean distclean deps doc install uninstall all
