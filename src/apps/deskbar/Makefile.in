prefix=@prefix@
bindir=$(prefix)/bin

CFLAGS   = -g -c -DDB_ADDONS -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CXXFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

CC	= @CC@
CXX	= @CXX@
EXE	= deskbar
COSMOELIBDIR=@top_srcdir@/src/kits/objs
TRACKERLIBDIR=@top_srcdir@/src/kits/tracker/objs

OBJDIR	:= objs


$(OBJDIR)/%.o : %.c
	$(CC) $(CFLAGS) $< -o $@

$(OBJDIR)/%.o : %.cpp
	$(CXX) $(CXXFLAGS) $< -o $@


OBJS := BarApp.o BarMenuBar.o BarMenuTitle.o BarView.o BarWindow.o CalendarMenuWindow.o DeskbarMenu.o DeskbarUtils.o \
		ExpandoMenuBar.o InlineScrollView.o PreferencesWindow.o ResourceSet.o ShowHideMenuItem.o StatusView.o \
		StatusViewShelf.o Switcher.o TeamMenu.o TeamMenuItem.o TimeView.o TruncatableMenuItem.o \
		WindowMenu.o WindowMenuItem.o
OBJS := $(addprefix $(OBJDIR)/,$(OBJS))


$(EXE): objs $(OBJS) Makefile
	$(CXX) -g $(OBJS) -L$(TRACKERLIBDIR) -L$(COSMOELIBDIR) -lcosmoe -ltracker -o $(EXE)

objs:
	mkdir objs

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)
	strip --strip-all $(bindir)/$(EXE)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile

.PHONY: clean distclean deps doc install uninstall all