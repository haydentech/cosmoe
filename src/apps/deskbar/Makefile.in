CFLAGS   = -g -c -DDB_ADDONS -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

EXE	= Deskbar

OBJS := BarApp.o BarMenuBar.o BarMenuTitle.o BarView.o BarWindow.o CalendarMenuWindow.o DeskbarMenu.o DeskbarUtils.o \
		ExpandoMenuBar.o InlineScrollView.o PreferencesWindow.o ResourceSet.o ShowHideMenuItem.o StatusView.o \
		StatusViewShelf.o Switcher.o TeamMenu.o TeamMenuItem.o TimeView.o TruncatableMenuItem.o \
		WindowMenu.o WindowMenuItem.o

include @top_srcdir@/makefile.rules

$(EXE): $(OBJDIR) $(OBJS) Makefile $(OBJDIR)/$(EXE).rsrc  $(OBJDIR)/icons.rsrc
	$(CXX) -g $(OBJS) -L$(TRACKERLIBDIR) -L$(BELIBDIR) -lbe -ltracker -o $(EXE)
	@XRES@ -o $(EXE) $(OBJDIR)/$(EXE).rsrc $(OBJDIR)/icons.rsrc

$(OBJDIR):
	mkdir $(OBJDIR)

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(EXE) $(OBJS) $(OBJDIR)/$(EXE).rsrc $(OBJDIR)/icons.rsrc *~

distclean: clean
	-rm -f Makefile
	-rm -rf $(OBJDIR)

.PHONY: clean distclean deps doc install uninstall all
