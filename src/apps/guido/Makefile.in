CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

EXE	= guido

OBJS := app.o disapp.o diswindow.o disview.o

include @top_srcdir@/makefile.rules


$(EXE): $(OBJDIR) $(OBJS) Makefile $(OBJDIR)/$(EXE).rsrc
	$(CXX) $(OBJS) -L$(BELIBDIR) -lbe	\
		-lwayland-client -lwayland-cursor -lxkbcommon -lcairo -lpango-1.0 -lpangocairo-1.0 -lweston-14 -ljpeg -lwebp \
		-o $@
	@XRES@ -o $(EXE) $(OBJDIR)/$(EXE).rsrc

$(OBJDIR):
	mkdir $(OBJDIR)

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm -f $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile
	-rm -rf $(OBJDIR)

.PHONY: clean distclean deps doc install uninstall all
