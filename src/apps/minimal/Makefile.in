CFLAGS   = -g -c -Wall -Wno-multichar -Woverloaded-virtual -Wnon-virtual-dtor `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS)

EXE	= minimal

OBJS := app.o disapp.o disview.o diswindow.o

include @top_srcdir@/makefile.rules

$(EXE): $(OBJDIR) $(OBJS) Makefile
	$(CXX) $(OBJS) -L$(BELIBDIR) -lbe	\
		-lwayland-client -lwayland-cursor -lxkbcommon -lcairo -lpango-1.0 -lpangocairo-1.0 -ljpeg -lwebp \
		-o $@

$(OBJDIR):
	mkdir $(OBJDIR)

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile
	-rm -rf $(OBJDIR)
