prefix=@prefix@
bindir=${prefix}/bin

CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS)

CC	= @CC@
CXX	= @CXX@
EXE	= seminfo portinfo
BELIBDIR=@top_srcdir@/src/kits/objs

OBJDIR	:= objs


$(OBJDIR)/%.o : %.c
	$(CC) $(CFLAGS) $< -o $@

$(OBJDIR)/%.o : %.cpp
	$(CXX) $(CPPFLAGS) $< -o $@


OBJS := seminfo.o portinfo.o

all: $(EXE)

seminfo: seminfo.o
	$(CXX) seminfo.o -L$(BELIBDIR) -lbe -o seminfo

portinfo: portinfo.o
	$(CXX) portinfo.o -L$(BELIBDIR) -lbe -o portinfo

objs:
	mkdir objs

install: $(EXE) $(bindir)
	cp -f seminfo $(bindir)
	cp -f portinfo $(bindir)
	strip --strip-all $(bindir)/seminfo
	strip --strip-all $(bindir)/portinfo

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile

seminfo.o : seminfo.cpp

portinfo.o : portinfo.cpp

.PHONY: clean distclean all install
