prefix=@prefix@
bindir=$(prefix)/bin

CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

CC	= @CC@
CXX	= @CXX@
EXE	= Pulse

OBJS	= DeskbarPulseView.o ProgressBar.o PulseApp.o PulseWindow.o ConfigView.o \
			CPUButton.o PrefsWindow.o NormalPulseView.o MiniPulseView.o PulseView.o Prefs.o

include @top_srcdir@/makefile.rules

$(EXE): objs $(OBJS) Makefile $(OBJDIR)/$(EXE).rsrc
	$(CXX) -g $(OBJS) -L$(COSMOELIBDIR) -lcosmoe -o $(EXE)
	@XRES@ -o $(OBJDIR)/$(EXE) $(OBJDIR)/$(EXE).rsrc

objs:
	mkdir objs

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)
	strip --strip-all $(bindir)/$(EXE)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile

.PHONY: clean distclean deps doc install uninstall all
