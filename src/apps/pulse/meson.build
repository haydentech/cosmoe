app_name = 'Pulse'
linux_desktop_id = 'x-vnd.Haiku-Pulse'
linux_desktop_categories = 'System;Monitor;'

app_srcs = files(
    'PulseApp.cpp',
    'PulseView.cpp',
    'PulseWindow.cpp',
    'ProgressBar.cpp',
	'PrefsWindow.cpp',
	'Prefs.cpp',
	'NormalPulseView.cpp',
	'MiniPulseView.cpp',
	'CPUButton.cpp',
	'ConfigView.cpp',
)


app_resource_defs = files(
    app_name + '.rdef'
)

app_dependencies = [dep_libbe, dep_libtracker]
