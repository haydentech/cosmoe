CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

EXE	= resedit


OBJS := App.o BitmapView.o ImageEditor.o InlineEditor.o MiscEditors.o NumberEditors.o PreviewColumn.o \
		ResFields.o ResListView.o ResourceData.o ResourceRoster.o ResView.o ResWindow.o

include @top_srcdir@/makefile.rules

$(EXE): $(OBJDIR) $(OBJS) Makefile
	$(CXX) -g $(OBJS) -L$(TRACKERLIBDIR) -L$(BELIBDIR) -lbe -ltracker -o $(EXE)

$(OBJDIR):
	mkdir $(OBJDIR)

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(EXE) $(OBJS) *~ $(OBJDIR)/$(EXE).rsrc

distclean: clean
	-rm -f Makefile
	-rm -rf $(OBJDIR)

.PHONY: clean distclean deps doc install uninstall all