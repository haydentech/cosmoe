CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

EXE	= ShowImage


OBJS := Filter.o PrintOptionsWindow.o ProgressWindow.o SelectionBox.o ShowImageApp.o \
	ShowImageSettings.o ShowImageStatusView.o ShowImageView.o ShowImageWindow.o SupportingAppsMenu.o ToolBarIcons.o \
	ImageCache.o ImageFileNavigator.o

include @top_srcdir@/makefile.rules

$(EXE): $(OBJDIR) $(OBJS) Makefile
	$(CXX) -g $(OBJS) -L$(TRACKERLIBDIR) -L$(COSMOELIBDIR) -lcosmoe -ltracker -o $(EXE)

$(OBJDIR):
	mkdir $(OBJDIR)

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile
	-rm -rf $(OBJDIR)

.PHONY: clean distclean deps doc install uninstall all