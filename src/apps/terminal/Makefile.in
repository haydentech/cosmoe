prefix=@prefix@
bindir=$(prefix)/bin

CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs`
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

CC	= @CC@
CXX	= @CXX@
EXE	= Terminal

OBJS := ActiveProcessInfo.o AppearPrefView.o Arguments.o \
	BasicTerminalBuffer.o \
	Colors.o ColorListView.o ColorPreview.o \
	FindWindow.o \
	Globals.o \
	HistoryBuffer.o HyperLink.o \
	InlineInput.o \
	PatternEvaluator.o PrefHandler.o PrefWindow.o \
	SetTitleDialog.o Shell.o ShellInfo.o ShellParameters.o SmartTabView.o \
	TermApp.o TerminalBuffer.o TerminalCharClassifier.o TermConst.o TerminalRoster.o TermParse.o TermScrollView.o \
	TermView.o TermViewHighlight.o TermViewStates.o TermWindow.o ThemeView.o ThemeWindow.o TitlePlaceholderMapper.o \
	VTKeyTbl.o VTPrsTbl.o

include @top_srcdir@/makefile.rules

$(EXE): objs $(OBJS) Makefile $(OBJDIR)/$(EXE).rsrc $(OBJDIR)/XColors.rsrc
	$(CXX) -g $(OBJS) -L$(TRACKERLIBDIR) -L$(COSMOELIBDIR) -lcosmoe -ltracker -o $(EXE)
	@XRES@ -o $(OBJDIR)/$(EXE) $(OBJDIR)/$(EXE).rsrc $(OBJDIR)/XColors.rsrc

objs:
	mkdir objs

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)
	strip --strip-all $(bindir)/$(EXE)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile

.PHONY: clean distclean deps doc install uninstall all