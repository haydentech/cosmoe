prefix=@prefix@
bindir=${prefix}/bin

CFLAGS	= `cat @top_srcdir@/cosmoe.specs` -g -Wall -Wno-multichar -c -I@top_srcdir@/headers/tools/cppunit
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

OBJDIR	:= objs

OBJS	= main.o testlist.o teststopwatch.o testentry.o testoskit.o testports.o testsem.o testsempingpong.o testporttorture.o testharness.o \
			teststorage.o StatableTest.o EntryTest.o NodeTest.o DirectoryTest.o BasicTest.o BTestCase.o BTestSuite.o PathTest.o testdirent.o \
			FileTest.o TestShell.o TestListener.o
OBJS := $(addprefix $(OBJDIR)/,$(OBJS))

EXE	= testharness testlist teststopwatch testoskit testports testsem testsempingpong testporttorture testentry testvolume teststorage
EXE := $(addprefix $(OBJDIR)/,$(EXE))


CC	= @CC@
CXX	= @CXX@

include @top_srcdir@/makefile.rules

all: $(OBJDIR) $(EXE) Makefile

$(OBJDIR):
	mkdir $(OBJDIR)

EntryTest.cpp: @top_srcdir@/src/tests/kits/storage/EntryTest.cpp
	ln -sf @top_srcdir@/src/tests/kits/storage/EntryTest.cpp EntryTest.cpp

EntryTest.h: @top_srcdir@/src/tests/kits/storage/EntryTest.h
	ln -sf @top_srcdir@/src/tests/kits/storage/EntryTest.h EntryTest.h

EntryTest.o: EntryTest.cpp EntryTest.h

PathTest.cpp: @top_srcdir@/src/tests/kits/storage/PathTest.cpp
	ln -sf @top_srcdir@/src/tests/kits/storage/PathTest.cpp PathTest.cpp

PathTest.h: @top_srcdir@/src/tests/kits/storage/PathTest.h
	ln -sf @top_srcdir@/src/tests/kits/storage/PathTest.h PathTest.h

PathTest.o: PathTest.cpp PathTest.h
	$(CXX) $(CFLAGS) -c $<

FileTest.cpp: @top_srcdir@/src/tests/kits/storage/FileTest.cpp
	ln -sf @top_srcdir@/src/tests/kits/storage/FileTest.cpp FileTest.cpp

FileTest.h: @top_srcdir@/src/tests/kits/storage/FileTest.h
	ln -sf @top_srcdir@/src/tests/kits/storage/FileTest.h FileTest.h

FileTest.o: FileTest.cpp FileTest.h
	$(CXX) $(CFLAGS) -c $<

NodeTest.cpp: @top_srcdir@/src/tests/kits/storage/NodeTest.cpp
	ln -sf @top_srcdir@/src/tests/kits/storage/NodeTest.cpp NodeTest.cpp

NodeTest.h: @top_srcdir@/src/tests/kits/storage/NodeTest.h
	ln -sf @top_srcdir@/src/tests/kits/storage/NodeTest.h NodeTest.h

NodeTest.o: NodeTest.cpp NodeTest.h
	$(CXX) $(CFLAGS) -c $<

DirectoryTest.cpp: @top_srcdir@/src/tests/kits/storage/DirectoryTest.cpp
	ln -sf @top_srcdir@/src/tests/kits/storage/DirectoryTest.cpp DirectoryTest.cpp

DirectoryTest.h: @top_srcdir@/src/tests/kits/storage/DirectoryTest.h
	ln -sf @top_srcdir@/src/tests/kits/storage/DirectoryTest.h DirectoryTest.h

DirectoryTest.o: DirectoryTest.cpp DirectoryTest.h
	$(CXX) -c DirectoryTest.cpp

$(OBJDIR)/testharness: $(OBJDIR)/testharness.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

$(OBJDIR)/testlist: $(OBJDIR)/testlist.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@
	
$(OBJDIR)/teststopwatch: $(OBJDIR)/teststopwatch.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

$(OBJDIR)/testoskit: $(OBJDIR)/testoskit.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

$(OBJDIR)/testports: $(OBJDIR)/testports.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

$(OBJDIR)/testporttorture: $(OBJDIR)/testporttorture.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

$(OBJDIR)/testsem: $(OBJDIR)/testsem.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

$(OBJDIR)/testsempingpong: $(OBJDIR)/testsempingpong.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -lrt -o $@

$(OBJDIR)/teststorage: $(OBJDIR)/teststorage.o $(OBJDIR)/StatableTest.o $(OBJDIR)/EntryTest.o $(OBJDIR)/PathTest.o \
						$(OBJDIR)/NodeTest.o $(OBJDIR)/DirectoryTest.o $(OBJDIR)/BasicTest.o $(OBJDIR)/BTestCase.o \
						$(OBJDIR)/BTestSuite.o $(OBJDIR)/FileTest.o $(OBJDIR)/TestShell.o $(OBJDIR)/TestListener.o
	$(CXX) $^ -L$(COSMOELIBDIR) -lcosmoe -lrt -lcppunit -o $@

$(OBJDIR)/testdirent: $(OBJDIR)/testdirent.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -lrt -o $@

$(OBJDIR)/testentry: $(OBJDIR)/testentry.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

$(OBJDIR)/testvolume: $(OBJDIR)/testvolume.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

install:
	cp -f clean_shm.sh $(bindir)

clean:
	-rm $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile

.PHONY: clean distclean deps doc install uninstall all
