prefix=@prefix@
bindir=$(prefix)/bin

COPTS	= `cat @top_srcdir@/cosmoe.specs` -Wall -Wno-multichar -Woverloaded-virtual -Wnon-virtual-dtor -c

//EXE		= setdecor setcontrollook mimeset xres listres catattr copyattr listattr listport
//OBJS	= setdecor.o setcontrollook.o mimeset.o xres.o listres.o catattr.o copyattr.o listattr.o listport.o

EXE		= xres listres
OBJS	= xres.o listres.o


BELIBDIR = @top_srcdir@/src/kits/objs

CXX	= @CXX@

all: $(EXE) $(OBJS) Makefile

%.rsrc : %.rdef 
	@RC@ $< -o $@ -I .

mimeset: mimeset.o mimeset.rsrc xres
	$(CXX) $< -L$(BELIBDIR) -lbe -o $@
	@XRES@ -o $@ mimeset.rsrc

setdecor: setdecor.o
	$(CXX) $< -L$(BELIBDIR) -lbe -o $@

setcontrollook: setcontrollook.o
	$(CXX) $< -L$(BELIBDIR) -lbe -o $@

xres: xres.o
	$(CXX) $< -L$(BELIBDIR) -lbe \
		-lwayland-client -lwayland-cursor -lxkbcommon -lcairo -lpango-1.0 -lpangocairo-1.0 -lweston-14 -ljpeg -lwebp \
		-o $@

listres: listres.o
	$(CXX) $< -L$(BELIBDIR) -lbe \
		-lwayland-client -lwayland-cursor -lxkbcommon -lcairo -lpango-1.0 -lpangocairo-1.0 -lweston-14 -ljpeg -lwebp \
		-o $@

listattr: listattr.o
	$(CXX) $< -L$(BELIBDIR) -lbe -o $@

listport: listport.o
	$(CXX) $< -L$(BELIBDIR) -lbe -o $@

catattr: catattr.o
	$(CXX) $< -L$(BELIBDIR) -lbe -o $@

copyattr: copyattr.o
	$(CXX) $< -L$(BELIBDIR) -lbe -o $@

install: $(EXE) $(bindir)
	@for subitem in $(EXE); do\
		cp -f $$subitem $(bindir) ;\
	done

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(OBJS) *~
	
distclean: clean
	-rm -f Makefile

.cpp.o:
	$(CXX) $(COPTS) $< -o $@

.c.o:
	$(CXX) $(COPTS) $< -o $@

.PHONY: clean distclean deps doc install uninstall all
