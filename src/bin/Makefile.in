prefix=@prefix@
bindir=$(prefix)/bin

COPTS	= `cat @top_srcdir@/cosmoe.specs` -Wall -Wno-multichar -Woverloaded-virtual -Wnon-virtual-dtor -c

EXE		= setdecor setcontrollook mimeset xres listres catattr copyattr
OBJS	= setdecor.o setcontrollook.o mimeset.o xres.o listres.o catattr.o copyattr.o

COSMOELIBDIR = @top_srcdir@/src/kits/objs

CXX	= @CXX@

all: $(EXE) $(OBJS) Makefile

mimeset: mimeset.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

setdecor: setdecor.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

setcontrollook: setcontrollook.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

xres: xres.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

listres: listres.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

catattr: catattr.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

copyattr: copyattr.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

install: $(EXE) $(bindir)
	@for subproj in $(EXE); do\
		cp -f $$subproj $(bindir) ;\
	done

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(OBJS) *~
	
distclean: clean
	-rm -f Makefile

.cpp.o:
	$(CXX) $(COPTS) $< -o $@

.PHONY: clean distclean deps doc install uninstall all
