prefix=@prefix@
bindir=$(prefix)/bin

COPTS	= `cat @top_srcdir@/cosmoe.specs` -Wall -Wno-multichar -Woverloaded-virtual -Wnon-virtual-dtor -c

OBJS	= xres.o listres.o
COSMOELIBDIR = @top_srcdir@/src/kits/objs

CXX	= @CXX@
LL	= @CXX@ 

all : xres listres $(OBJS) Makefile

xres: xres.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

listres: listres.o
	$(CXX) $< -L$(COSMOELIBDIR) -lcosmoe -o $@

install: $(EXE) $(bindir)
	cp -f xres $(bindir)
	cp -f listres $(bindir)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(EXE) $(OBJS) *~
	
distclean: clean
	-rm -f Makefile

.cpp.o:
	$(CXX) $(COPTS) $< -o $@

.PHONY: clean distclean deps doc install uninstall all
