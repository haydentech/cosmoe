prefix=@prefix@
bindir=$(prefix)/bin

CPPFLAGS	= -g `cat @top_srcdir@/cosmoe.specs` -Wall -Wno-multichar -Woverloaded-virtual -Wnon-virtual-dtor -c

OBJS	= rc.o rdef.o parser.o lexer.o compile.o decompile.o
EXE	= rc
BELIBDIR = @top_srcdir@/src/kits/objs

CXX	= @CXX@
LL	= @CXX@

LEX     = flex
YACC    = bison
YFLAGS  = -d


$(EXE) : $(OBJS) Makefile parser.o
	$(LL) $(OBJS) -L$(BELIBDIR) -lbe 	\
		-lwayland-client -lwayland-cursor -lxkbcommon -lcairo -lpango-1.0 -lpangocairo-1.0 -ljpeg -lwebp \
		-o $@

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm -f $(EXE) $(OBJS) *~ parser.tab.* parser.[ch]pp lexer.cpp parser.ypp
	
distclean: clean
	-rm -f Makefile
	-rm -rf $(OBJDIR)

lexer.cpp: lexer.l
	flex -t $< > $@

lexer.o: lexer.cpp parser.hpp
	$(CXX) $(CPPFLAGS) $< -o $@

parser.ypp: parser.y
	cp parser.y parser.ypp

parser.tab.hpp: parser.tab.cpp

parser.tab.cpp: parser.ypp
	bison -d $<

parser.hpp: parser.tab.hpp
	cp $< $@

parser.cpp: parser.tab.cpp
	cp $< $@

compile.o: parser.hpp

.cpp.o:
	$(CXX) $(CPPFLAGS) $< -o $@

.PHONY: clean distclean deps doc install uninstall all lexer.c
