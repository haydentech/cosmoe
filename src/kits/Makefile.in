prefix=@prefix@
libdir=${prefix}/lib

CFLAGS   = -fPIC -Wall -Wpointer-arith -Wcast-align -Wsign-compare -Wno-multichar -c -g -O2 -pipe `cat @top_srcdir@/cosmoe.specs | tr '\n' ' '`
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wno-ctor-dtor-privacy -Wnon-virtual-dtor -fexceptions -fpermissive

LIBNAME = libcosmoe.@LIBEXT@

VPATH += ./ app interface storage support shared translation textencoding \
		../system/kernel ../system/kernel/util interface/layouter interface/textview_support storage/mime storage/sniffer \
		../system/libroot/os ../system/libroot/os/locks

CC	= @CC@

OBJS =	Alert.o Alignment.o AppDefs.o AppFileInfo.o Application.o AppServerLink.o AbstractLayout.o \
			AppMisc.o Archivable.o area.o AreaLink.o atomic.o AffineTransform.o ArchivingManagers.o \
		AbstractLayoutItem.o \
		Beep.o Bitmap.o BitmapStream.o BlockCache.o BMCPrivate.o Box.o BufferIO.o ByteOrder.o \
			Button.o \
		CardLayout.o CheckBox.o Clipboard.o ColorControl.o ColorConversion.o ColorUtils.o Control.o Cursor.o \
		ComplexLayouter.o ControlLook.o CharacterSet.o CharacterSetRoster.o character_sets.o CollapsingLayouter.o \
		DirectMessageTarget.o DataBuffer.o DataIO.o Deskbar.o Directory.o Dragger.o DesktopLink.o \
		DragTrackingFilter.o \
		Entry.o EntryList.o \
		File.o FindDirectory.o Flattenable.o Font.o fs.o FuncTranslator.o \
		GraphicsDefs.o GroupLayout.o \
		Gradient.o GradientConic.o GradientDiamond.o GradientLinear.o GradientRadial.o GradientRadialFocus.o \
		Handler.o HashString.o \
		InitTerminateLibBe.o InlineInput.o Input.o \
			InterfaceDefs.o Invoker.o \
		kernel_interface.POSIX.o \
		Layout.o Layouter.o LayoutContext.o LayoutItem.o LayoutOptimizer.o LayoutUtils.o \
		LineBuffer.o LinkReceiver.o LinkSender.o List.o Locker.o Looper.o LooperList.o \
		Message.o Messenger.o MessageAdapter.o MessageQueue.o MessageUtils.o MessageRunner.o \
			MessageFilter.o Menu.o MenuBar.o MenuPrivate.o \
			MenuField.o MenuItem.o MenuWindow.o Mime.o MimeType.o misc.o \
		Node.o NodeInfo.o NodeMonitor.o \
		OffsetFile.o OneElementLayouter.o \
		parsedate.o Path.o Picture.o PictureButton.o PicturePlayer.o Point.o PointerList.o Polygon.o \
		PopUpMenu.o PortLink.o PrivateScreen.o PropertyInfo.o \
		Query.o QueryPredicate.o \
		RadioButton.o real_time_clock.o Rect.o Region.o RegionSupport.o \
			RegistrarDefs.o RegistrarThread.o Referenceable.o RegistrarThreadManager.o \
			Resources.o ResourcesContainer.o ResourceFile.o \
			ResourceItem.o ResourceStrings.o Roster.o RosterPrivate.o \
		Screen.o ScrollBar.o ScrollView.o SeparatorItem.o \
			ServerLink.o ServerMemoryAllocator.o Server.o \
			Shape.o Shelf.o Size.o Slider.o Statable.o StatusBar.o StopWatch.o \
			storage_support.o String.o @STRCASESTROBJ@ \
			StringView.o StyleBuffer.o SymLink.o SplitLayout.o SimpleLayouter.o \
		TabView.o TextControl.o TextGapBuffer.o TextInput.o TextView.o \
			thread.o TokenSpace.o TPicture.o Translator.o TranslationUtils.o ToolTip.o ToolTipManager.o \
			TranslatorRoster.o TwoDimensionalLayout.o \
		UndoBuffer.o utf8_conversions.o \
		View.o ViewLayoutItem.o Volume.o VolumeRoster.o \
		WidthBuffer.o Window.o \
		ZombieReplicantView.o \
		\
		AssociatedTypes.o Database.o SnifferRules.o \
		CreateAppMetaMimeThread.o  database_support.o  Supertype.o \
		InstalledTypes.o SupportingApps.o database_access.o \
		MimeUpdateThread.o UpdateMimeInfoThread.o \
		\
		CharStream.o Err.o Pattern.o Range.o RPatternList.o DisjList.o \
		Parser.o PatternList.o RPattern.o Rule.o \
		sem.o team.o port.o list.o image.o \
		\
		init_once.o


OBJDIR	:= objs

include @top_srcdir@/makefile.rules

all :	$(OBJDIR) $(OBJDIR)/$(LIBNAME)

$(OBJDIR):
	mkdir $(OBJDIR)

$(OBJDIR)/$(LIBNAME): $(OBJS) Makefile
	$(CC) @SHAREDLINK@ $(OBJS) -lstdc++ -lm -lpthread -lpng -ldl -Wl,--whole-archive @top_srcdir@/src/libs/icon/objs/libicon.a @top_srcdir@/src/libs/agg/objs/libagg.a -Wl,--no-whole-archive -o $(OBJDIR)/$(LIBNAME)

install: $(OBJDIR)/$(LIBNAME) $(libdir)
	cp -f $< $(libdir)/$(LIBNAME)

uninstall:
	rm -f $(libdir)/$(LIBNAME)

$(libdir):
	mkdir -p $(libdir)

doc:
	-rm -R docs/*
	doxygen libcosmoe.dox

deps: $(OBJDIR) $(DEPS)

clean:
	rm -f $(OBJS) $(OBJDIR)/$(LIBNAME) $(OBJDIR)/*.d *~ */*~ core*
	rm -rf docs/*

distclean: clean
	rm -f Makefile
	rm -rf autom4te.cache

-include $(OBJDIR)/*.d

.PHONY: clean distclean deps doc install uninstall all
