include @top_srcdir@/makefile.rules

all :	$(OBJDIR) $(OBJDIR)/$(LIBBE) $(OBJDIR)/$(LIBLOCALESTUB)

$(OBJDIR):
	mkdir $(OBJDIR)

$(OBJDIR)/$(LIBBE): $(OBJS) Makefile
	$(CC) @SHAREDLINK@ $(OBJS) `pkg-config --libs icu-uc icu-io` -lstdc++ -lm -lpthread \
	-Wl,--whole-archive @top_srcdir@/src/libs/agg/objs/libagg.a @top_srcdir@/src/libs/mapm/objs/libmapm.a @top_srcdir@/src/libs/icon/objs/libicon.a  -Wl,--no-whole-archive \
	-o $(OBJDIR)/$(LIBBE)

$(OBJDIR)/$(LIBLOCALESTUB): Makefile
	echo "" | $(CC) @SHAREDLINK@ -fPIC -x c++ - -o $(OBJDIR)/$(LIBLOCALESTUB)

addresources: $(OBJDIR)/CountryFlags.rsrc $(OBJDIR)/LanguageFlags.rsrc $(OBJDIR)/libbe_version.rsrc $(OBJDIR)/Icons.rsrc
	@XRES@ -o $(OBJDIR)/$(LIBBE) $(OBJDIR)/CountryFlags.rsrc $(OBJDIR)/LanguageFlags.rsrc $(OBJDIR)/libbe_version.rsrc $(OBJDIR)/Icons.rsrc

install: $(OBJDIR)/$(LIBBE) $(OBJDIR)/$(LIBLOCALESTUB) $(libdir)
	cp -f $< $(libdir)/$(LIBBE)
	cp -f $< $(libdir)/$(LIBLOCALESTUB)

uninstall:
	rm -f $(libdir)/$(LIBBE)

$(libdir):
	mkdir -p $(libdir)

deps: $(OBJDIR) $(DEPS)

clean:
	rm -f $(OBJS) $(OBJDIR)/$(LIBBE) $(OBJDIR)/*.d *~ */*~ core* $(OBJDIR)/*.rsrc
	rm -rf docs/*

distclean: clean
	rm -f Makefile
	rm -rf autom4te.cache

-include $(OBJDIR)/*.d

.PHONY: clean distclean deps doc install uninstall all addresources
