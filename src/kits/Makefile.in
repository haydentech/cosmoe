CFLAGS   = -fPIC -Wall -Wpointer-arith -Wcast-align -Wsign-compare -Wno-multichar -c -g -O2 -pipe `cat @top_srcdir@/cosmoe.specs | tr '\n' ' '` \
		`pkg-config cairo --cflags`		\
		`pkg-config pango --cflags`
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wno-ctor-dtor-privacy -Wnon-virtual-dtor -fexceptions

LIBBE = libbe.@LIBEXT@
LIBLOCALESTUB = liblocalestub.@LIBEXT@

VPATH += ./ app game interface locale storage support shared translation textencoding \
		../system/kernel ../system/kernel/util interface/layouter interface/textview_support storage/mime \
		storage/disk_device storage/disk_device/jobs storage/sniffer \
		../system/libroot/os ../system/libroot/os/locks \
		../system/wayland/clients ../system/wayland/shared ../system/wayland/protocol

