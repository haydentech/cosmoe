include @top_srcdir@/makefile.rules

all :	$(OBJDIR) $(OBJDIR)/$(LIBNAME)

$(OBJDIR):
	mkdir $(OBJDIR)

#$(OBJDIR)/CountryFlags.rsrc $(OBJDIR)/LanguageFlags.rsrc $(OBJDIR)/libbe_version.rsrc

$(OBJDIR)/$(LIBNAME): $(OBJS) Makefile
	$(CC) @SHAREDLINK@ $(OBJS)  \
	-lstdc++ -lm -lpthread \
	-l:libtoytoolkit.a \
	-l:libcairo-shared.a \
	-o $(OBJDIR)/$(LIBNAME)
#-lpng -ldl `pkg-config --libs icu-uc icu-io`
#	-Wl,--whole-archive @top_srcdir@/src/libs/agg/objs/libagg.a @top_srcdir@/src/libs/mapm/objs/libmapm.a -Wl,--no-whole-archive \

addresources: $(OBJDIR)/CountryFlags.rsrc $(OBJDIR)/LanguageFlags.rsrc $(OBJDIR)/libbe_version.rsrc $(OBJDIR)/Icons.rsrc
	@XRES@ -o $(OBJDIR)/$(LIBNAME) $(OBJDIR)/CountryFlags.rsrc $(OBJDIR)/LanguageFlags.rsrc $(OBJDIR)/libbe_version.rsrc $(OBJDIR)/Icons.rsrc

install: $(OBJDIR)/$(LIBNAME) $(libdir)
	cp -f $< $(libdir)/$(LIBNAME)

uninstall:
	rm -f $(libdir)/$(LIBNAME)

$(libdir):
	mkdir -p $(libdir)

deps: $(OBJDIR) $(DEPS)

clean:
	rm -f $(OBJS) $(OBJDIR)/$(LIBNAME) $(OBJDIR)/*.d *~ */*~ core* $(OBJDIR)/*.rsrc
	rm -rf docs/*

distclean: clean
	rm -f Makefile
	rm -rf autom4te.cache

-include $(OBJDIR)/*.d

.PHONY: clean distclean deps doc install uninstall all
