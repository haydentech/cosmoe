CFLAGS   = -fPIC -Wall -Wpointer-arith -Wcast-align -Wsign-compare -Wno-multichar -c -g -O2 -pipe `cat @top_srcdir@/cosmoe.specs | tr '\n' ' '`
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wno-ctor-dtor-privacy -Wnon-virtual-dtor -fexceptions

LIBNAME = libtracker.@LIBEXT@

VPATH += ./ app game interface locale storage support shared translation textencoding tracker \
		../system/kernel ../system/kernel/util interface/layouter interface/textview_support storage/mime storage/sniffer \
		../system/libroot/os ../system/libroot/os/locks infowindow

OBJS =	\
			AttributeStream.o \
			AttributesView.o \
			AutoMounterSettings.o \
			BackgroundImage.o \
			Bitmaps.o \
			ContainerWindow.o \
			CountView.o \
			DeskWindow.o \
			DesktopPoseView.o \
			DraggableContainerIcon.o \
			DialogPane.o \
			DirMenu.o \
			EntryIterator.o \
			FBCPadding.o \
			FSClipboard.o \
			FSUndoRedo.o \
			FSUtils.o \
			FavoritesMenu.o \
			FilePanel.o \
			FilePanelPriv.o \
			FilePermissionsView.o \
			FindPanel.o \
			GeneralInfoView.o \
			GroupedMenu.o \
			HeaderView.o \
			IconCache.o \
			IconMenuItem.o \
			InfoWindow.o \
			MimeTypeList.o \
			MiniMenuField.o \
			Model.o \
			MountMenu.o \
			Navigator.o \
			NavMenu.o \
			NodePreloader.o \
			NodeWalker.o \
			OpenWithWindow.o \
			OverrideAlert.o \
			PendingNodeMonitorCache.o \
			Pose.o \
			PoseList.o \
			PoseView.o \
			PoseViewScripting.o \
			QueryContainerWindow.o \
			QueryPoseView.o \
			RecentItems.o \
			RegExp.o \
			SelectionWindow.o \
			Settings.o \
			SettingsViews.o \
			SlowMenu.o \
			StatusWindow.o \
			TaskLoop.o \
			TemplatesMenu.o \
			Tests.o \
			TextWidget.o \
			Thumbnails.o \
			TitleView.o \
			Tracker.o \
			TrackerInitialState.o \
			TrackerScripting.o \
			TrackerSettings.o \
			TrackerSettingsWindow.o \
			TrackerString.o \
			TrashWatcher.o \
			Utilities.o \
			ViewState.o \
			VirtualDirectoryEntryList.o \
			VirtualDirectoryManager.o \
			VirtualDirectoryPoseView.o \
			VirtualDirectoryWindow.o \
			WidgetAttributeText.o


include @top_srcdir@/makefile.rules

all : $(OBJDIR) $(OBJDIR)/$(LIBNAME)

$(OBJDIR):
	mkdir $(OBJDIR)

$(OBJDIR)/$(LIBNAME): $(OBJS) Makefile
	$(CC) @SHAREDLINK@ $(OBJS) -lstdc++ -o $(OBJDIR)/$(LIBNAME)

addresources: $(OBJDIR)/libtracker.rsrc $(OBJDIR)/TrackerIcons.rsrc
	@XRES@ -o $(OBJDIR)/$(LIBNAME) $(OBJDIR)/libtracker.rsrc $(OBJDIR)/TrackerIcons.rsrc

install: $(OBJDIR)/$(LIBNAME) $(libdir)
	cp -f $< $(libdir)/$(LIBNAME)

uninstall:
	rm -f $(libdir)/$(LIBNAME)

$(libdir):
	mkdir -p $(libdir)

deps: $(OBJDIR) $(DEPS)

clean:
	rm -f $(OBJS) $(OBJDIR)/$(LIBNAME) $(OBJDIR)/*.d *~ */*~ core* $(OBJDIR)/*.rsrc
	rm -rf docs/*

distclean: clean
	rm -f Makefile
	rm -rf $(OBJDIR)
	rm -rf autom4te.cache

-include $(OBJDIR)/*.d

.PHONY: clean distclean deps doc install uninstall all
