CFLAGS=-c -fPIC -g -O2 -Wno-multichar `cat @top_srcdir@/icon.specs | tr '\n' ' '` `cat @top_srcdir@/cosmoe.specs | tr '\n' ' '` 
CPPFLAGS=$(CFLAGS)

LIBNAME=libicon.a
VPATH = flat_icon message shape style transformable transformer
OBJS = 	\
	AffineTransformer.o \
	CompoundStyleTransformer.o ContourTransformer.o \
	Defines.o \
	FlatIconFormat.o FlatIconImporter.o \
	GradientTransformable.o \
	Icon.o IconRenderer.o IconUtils.o \
	LittleEndianBuffer.o  \
	MessageImporter.o \
	Shape.o Style.o StrokeTransformer.o StyleTransformer.o \
	PathCommandQueue.o PathSource.o PathSourceShape.o PerspectiveTransformer.o \
	Transformable.o TransformerFactory.o \
	VectorPath.o 


include @top_srcdir@/makefile.rules

all :   $(OBJDIR) $(OBJDIR)/$(LIBNAME)

$(OBJDIR):
	mkdir $(OBJDIR)

$(OBJDIR)/$(LIBNAME): $(OBJS) Makefile
	ar rcs $(OBJDIR)/$(LIBNAME) $(OBJS)

install:

deps:

clean:
	rm -rf $(OBJDIR)

distclean: clean
	rm Makefile
