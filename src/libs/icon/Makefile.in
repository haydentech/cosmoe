CFLAGS=-c -fPIC -g -O2 -Wno-multichar `cat @top_srcdir@/icon.specs | tr '\n' ' '` `cat @top_srcdir@/cosmoe.specs | tr '\n' ' '` 
CPPFLAGS=$(CFLAGS)
CC=@CC@
LIBNAME=libicon.a
VPATH = flat_icon message shape style transformable transformer
OBJS = 	\
	Icon.o IconRenderer.o IconUtils.o \
	FlatIconFormat.o FlatIconImporter.o LittleEndianBuffer.o PathCommandQueue.o \
	Defines.o MessageImporter.o \
	Shape.o VectorPath.o \
	GradientTransformable.o Style.o StyleTransformer.o CompoundStyleTransformer.o \
	Transformable.o \
	AffineTransformer.o ContourTransformer.o PathSource.o PathSourceShape.o PerspectiveTransformer.o StrokeTransformer.o TransformerFactory.o

OBJDIR  := objs

include @top_srcdir@/makefile.rules

all :   $(OBJDIR) $(OBJDIR)/$(LIBNAME)

$(OBJDIR):
	mkdir $(OBJDIR)

$(OBJDIR)/$(LIBNAME): $(OBJS) Makefile
	ar rcs $(OBJDIR)/$(LIBNAME) $(OBJS)

install:

deps:

clean:
	rm -rf $(OBJDIR)

distclean: clean
	rm Makefile
