CFLAGS=-c -fPIC -g -O2 -Wno-multichar `cat @top_srcdir@/icon.specs | tr '\n' ' '` `cat @top_srcdir@/cosmoe.specs | tr '\n' ' '` 
CPPFLAGS=$(CFLAGS)
CC=@CC@
LIBNAME=liblinprog.a
VPATH = 
OBJS = 	\
	ActiveSetSolver.o Constraint.o LayoutOptimizer.o \
	LinearSpec.o Summand.o Variable.o 

OBJDIR  := objs

include @top_srcdir@/makefile.rules

all :   $(OBJDIR) $(OBJDIR)/$(LIBNAME)

$(OBJDIR):
	mkdir $(OBJDIR)

$(OBJDIR)/$(LIBNAME): $(OBJS) Makefile
	ar rcs $(OBJDIR)/$(LIBNAME) $(OBJS)

install:

deps:

clean:
	rm -rf $(OBJDIR)

distclean: clean
	rm Makefile
