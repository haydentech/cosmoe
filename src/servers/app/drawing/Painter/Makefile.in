
CFLAGS=-c -g -O2 -Wno-multichar -Idrawing_modes `cat @top_srcdir@/cosmoe.specs | tr '\n' ' '` `pkg-config freetype2 --cflags` \
			-I../../font -I. -I.. -I../.. -Ibitmap_painter
CPPFLAGS=$(CFLAGS)

LIBNAME=libpainter.a
VPATH = src drawing_modes bitmap_painter font_support
OBJS = 	Painter.o \
		Transformable.o \
		PixelFormat.o \
		AGGTextRenderer.o \
		BitmapPainter.o

ifeq (m32,$(findstring m32,$(CC)))
    OBJS += painter_bilinear_scale.o
endif


include @top_srcdir@/makefile.rules

all :   $(OBJDIR) $(OBJDIR)/$(LIBNAME)

$(OBJDIR)/painter_bilinear_scale.o: painter_bilinear_scale.nasm
	nasm -f elf32 bitmap_painter/painter_bilinear_scale.nasm -o $(OBJDIR)/painter_bilinear_scale.o

$(OBJDIR):
	mkdir $(OBJDIR)

$(OBJDIR)/$(LIBNAME): $(OBJS)
	ar rcs $(OBJDIR)/$(LIBNAME) $(OBJS)

install:

deps:

clean:
	rm -rf $(OBJDIR)

distclean: clean
	rm Makefile
