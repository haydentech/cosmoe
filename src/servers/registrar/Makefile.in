CFLAGS   = -g -c -Wall -Wno-multichar `cat @top_srcdir@/cosmoe.specs | tr '\n' ' '` -Imime -I@top_srcdir@/headers/os/add-ons/registrar -I.
CPPFLAGS = $(CFLAGS) -Woverloaded-virtual -Wnon-virtual-dtor

EXE	= registrar

VPATH += ./ mime

OBJS := AppInfoList.o \
		AppInfoListMessagingTargetSet.o \
		AuthenticationManager.o \
		ClipboardHandler.o \
		Clipboard.o \
		CreateAppMetaMimeThread.o \
		Event.o \
		EventMaskWatcher.o \
		EventQueue.o \
		MessageEvent.o \
		MessageDeliverer.o \
		MessageHandler.o \
		MessageRunnerManager.o \
		MessagingService.o \
		MIMEManager.o \
		MimeUpdateThread.o \
		PackageWatchingManager.o \
		RecentApps.o \
		RecentEntries.o \
		Registrar.o \
		RegistrarThread.o \
		RegistrarThreadManager.o \
		RosterAppInfo.o \
		RosterSettingsCharStream.o \
		ShutdownProcess.o \
		TRoster.o \
		UpdateMimeInfoThread.o \
		Watcher.o \
		WatchingService.o

include @top_srcdir@/makefile.rules


$(EXE): $(OBJDIR) $(OBJS) $(OBJDIR)/$(EXE).rsrc
	$(CXX) -g $(OBJS) -lstdc++ -L$(COSMOELIBDIR) -lcosmoe -o $(OBJDIR)/$(EXE)
	@XRES@ -o $(OBJDIR)/$(EXE) $(OBJDIR)/$(EXE).rsrc

$(OBJDIR):
	mkdir $(OBJDIR)

install: $(OBJDIR)/$(EXE) $(bindir)
	cp -f $(OBJDIR)/$(EXE) $(bindir)

$(bindir):
	mkdir -p $(bindir)

clean:
	-rm $(OBJDIR)/$(EXE) $(OBJS) *~ $(OBJDIR)/$(EXE).rsrc

distclean: clean
	-rm -f Makefile
	-rm -rf $(OBJDIR)
