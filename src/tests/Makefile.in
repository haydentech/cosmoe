prefix=@prefix@
bindir=${prefix}/bin

COPTS	= `cat @top_srcdir@/cosmoe.specs` -g -Wall -Wno-multichar -c -I@top_srcdir@/headers/tools/cppunit

OBJS	= UnitTester.o
EXE		= unittester

OBJDIR	:= objs

CC	= @CXX@
LL	= @CXX@

include @top_srcdir@/makefile.rules

all: $(EXE)

$(EXE): UnitTester.o UnitTester.cpp Makefile
	$(LL) UnitTester.o -L$(BELIBDIR) -lbetest -lbe -L@top_srcdir@/src/tools/cppunit/objs -lcppunit -o $@

install: $(EXE) $(bindir)
	cp -f $(EXE) $(bindir)

clean:
	-rm $(EXE) $(OBJS) *~

distclean: clean
	-rm -f Makefile

.cpp.o:
	$(CC) $(COPTS) $< -o $@

.PHONY: clean distclean deps doc install uninstall all
